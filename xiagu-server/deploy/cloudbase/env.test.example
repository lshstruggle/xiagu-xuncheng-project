# xiagu-api-test / CloudBase HTTP 云函数测试环境
# 注意：本文件只保存非敏感配置和占位符，不要把真实密钥写入仓库。

SERVER_MODE=release

# 当前小程序使用的 CloudBase 环境
CLOUDBASE_ENV_ID=xiagu-miniprogram-d7dbpz54358b2f
CLOUDBASE_DATABASE_INSTANCE=(default)
CLOUDBASE_DATABASE_NAME=(default)
CLOUDBASE_COLLECTION_PREFIX=test_

# 仅在 CloudBase 云函数环境变量中填写
CLOUDBASE_API_KEY=<从CloudBase环境配置-APIKey管理中创建>

# 当前微信小程序
WECHAT_APP_ID=wx8244132050006399
WECHAT_APP_SECRET=<从微信公众平台获取>

# 使用 openssl rand -base64 48 生成；测试环境和生产环境使用不同值
JWT_SECRET=<至少32字符的随机密钥>

# 腾讯元器文字对话
YUANQI_BASE_URL=https://open.hunyuan.tencent.com/openapi/v1/agent/chat/completions
YUANQI_TOKEN=<从腾讯元器控制台获取的API Token，不要添加Bearer前缀>
YUANQI_ASSISTANT_ID=2033060122909652160

# 可选实时 AI 对话语音。关闭或 CloudStudio 不可用时，聊天仍正常返回文字。
TTS_ENABLED=false
TTS_BASE_URL=https://<你的-cloudstudio-tts-https-入口>
TTS_SHARED_SECRET=<与CloudStudio服务一致的随机密钥>
TTS_TIMEOUT=90s
TTS_MAX_SEGMENT_RUNES=35

# 本地管理后台开发地址；上线后替换或追加正式 HTTPS 域名
ALLOWED_ADMIN_ORIGINS=http://localhost:5173
