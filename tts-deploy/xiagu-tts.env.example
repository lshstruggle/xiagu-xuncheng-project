# Copy to /workspace/.data/xiagu-tts.env and replace only the marked secret.
GPT_SOVITS_ROOT=/workspace/GPT-SoVITS
TTS_MODEL_DIR=/workspace/models/libai
TTS_CACHE_DIR=/workspace/.data/tts-cache
TTS_SHARED_SECRET=<replace-with-openssl-rand-output>
TTS_DEVICE=cuda
TTS_HALF=true
TTS_MODEL_VERSION=libai-v3
TTS_SPEED=1.0
TTS_BATCH_SIZE=1
TTS_SAMPLE_STEPS=16
TTS_TOP_K=20
TTS_TOP_P=0.75
TTS_TEMPERATURE=0.7
TTS_SPLIT_INTERVAL=0.3
TTS_REPETITION_PENALTY=1.35
TTS_INFERENCE_TIMEOUT_SECONDS=60
